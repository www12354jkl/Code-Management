          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m22" value="插入/更新 ROLLED_BACK 流水" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act8" target="act7">
