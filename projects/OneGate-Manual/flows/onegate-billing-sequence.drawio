          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m17" value="全渠道失败：即时投递回滚路由&#10;(并返回 HTTP 503)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.6806;entryX=0.5;entryY=0.6806;labelBackgroundColor=#ffffff;strokeColor=#b45309;fontColor=#b45309;" edge="1" parent="1" source="gw" target="rmq">
