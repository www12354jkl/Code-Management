          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="写 ai_token_ledger +&#10;扣减可用额度" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="事务落库确认 (含 DB 补偿)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act4" target="act5">
